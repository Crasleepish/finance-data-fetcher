environment: local
database:
  url: postgresql+psycopg2://
tushare:
  token_private: ""
  token_public: ""
data:
  index:
    stock: ""
    bond: ""
    gold: ""
  fund:
    money: ""
  rt_fetch_interval: 600
gold:
  cftc_history_url_template: "https://www.cftc.gov/files/dea/history/com_disagg_txt_{year}.zip"
  barchart_quotes_url: "https://www.barchart.com/proxies/core-api/v1/quotes/get"
  tmp_dir: "/tmp"
logging:
  level: INFO
  log_dir: logs
  log_file: logs/app.log
  rotation_when: midnight
  rotation_interval: 1
  backup_count: 30
  encoding: utf-8
  console: true
pipeline_mapping_path: config/task_pipeline_mapping.py
