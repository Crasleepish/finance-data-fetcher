digraph DataPipelineServiceV2 {
  rankdir=LR;
  compound=true;
  labelloc="t";
  label="Async Ingestion Service: Pipeline-based Fetch→Clean→Persist";

  node [shape=box, style="rounded,filled", fillcolor="#f7f7f7"];
  edge [];

  // ================= API =================
  subgraph cluster_api {
    label="API (FastAPI)";
    api_start  [label="POST /tasks/start\n(async, return run_id)"];
    api_list   [label="GET /tasks/running"];
    api_status [label="GET /tasks/{run_id}"];
  }

  // ================= Task & Workflow =================
  subgraph cluster_workflow {
    label="Workflow Orchestration";
    workflow     [label="WorkflowEngine\n(run orchestration)"];
    selector     [label="PipelineSelector\n(by source/task type)"];
    failover     [label="PipelineFailoverPolicy\n(optional)"];
    state_machine[label="Task State Machine"];
    progress     [label="Progress Tracker"];
    idempotency  [label="Idempotency Guard\n(active-run dedupe)"];
  }

  // ================= Async Runtime =================
  subgraph cluster_async {
    label="Async Runtime";
    queue   [label="Task Queue"];
    workers [label="Worker Pool"];
  }

  // ================= Trading Calendar =================
  subgraph cluster_calendar {
    label="Trading Day Management";
    calendar [label="TradingCalendarService\nnormalize date range"];
  }

  // ================= Ingestion Pipeline =================
  subgraph cluster_pipeline {
    label="IngestionPipeline (per data source / task type)";
    pipeline      [label="IngestionPipeline"];
    chunk_policy  [label="ChunkPolicy\n(plan chunks)"];
    fetcher       [label="Fetcher\n(chunk-level retry only)"];
    cleaner       [label="Cleaner\n(raw → normalized)"];
  }

  // ================= Persist =================
  subgraph cluster_persist {
    label="Persist Layer";
    repo [label="Repository\n(explicit tx, idempotent write)"];
    db   [label="Database"];
  }

  // ================= Status & Observability =================
  subgraph cluster_obs {
    label="Task Status & Observability";
    status_store [label="TaskRun Store\n(state, progress, stats)"];
    logs         [label="Logging"];
  }

  // -------- API → Async --------
  api_start -> idempotency;
  idempotency -> queue;
  api_list -> status_store;
  api_status -> status_store;

  // -------- Async execution --------
  queue -> workers;
  workers -> workflow;

  // -------- Workflow internals --------
  workflow -> selector;
  selector -> pipeline;
  workflow -> failover [style=dashed];

  workflow -> calendar;
  workflow -> state_machine;
  workflow -> progress;
  workflow -> status_store;

  // -------- Pipeline internals --------
  pipeline -> chunk_policy;
  pipeline -> fetcher;
  pipeline -> cleaner;

  workflow -> pipeline [label="for each chunk"];

  // -------- Persist --------
  workflow -> repo;
  repo -> db;

  // -------- Observability --------
  workflow -> logs [style=dashed];
}
